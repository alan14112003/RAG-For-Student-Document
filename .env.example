# Example configuration for the Student Knowledge RAG service.
# Copy this file to `.env` and fill in environment-specific values.

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=student_documents
QDRANT_COLLECTION=
QDRANT_RECREATE_COLLECTION=false

DATA_DIR=data/uploads

CHUNK_SIZE=800
CHUNK_OVERLAP=200

EMBEDDING_MODEL=mxbai-embed-large

# LLM Configuration (Gemini via OpenAI compatibility)
LLM_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=your_gemini_api_key_here
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
LLM_MAX_TOKENS=1000

MAX_UPLOAD_BYTES=52428800

CORS_ALLOW_ORIGINS=

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
MINIO_REGION=

DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rag_user
DB_PASSWORD=rag_pass
DB_NAME=rag_service
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_RECYCLE=3600

JWT_SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
